{
  "openapi": "3.1.0",
  "info": {
    "title": "invest-assistant",
    "version": "0.1.0"
  },
  "paths": {
    "/api/data/status": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Status",
        "operationId": "status_api_data_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/data/sync": {
      "post": {
        "tags": [
          "data"
        ],
        "summary": "Sync Now",
        "operationId": "sync_now_api_data_sync_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncAccepted"
                }
              }
            }
          },
          "409": {
            "description": "已有任务正在运行，没有排入",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          }
        }
      }
    },
    "/api/data/quality": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Quality",
        "operationId": "quality_api_data_quality_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataQuality"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/current": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Current",
        "operationId": "current_api_jobs_current_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/JobStatusOut"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Current Api Jobs Current Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/signals": {
      "get": {
        "tags": [
          "signals"
        ],
        "summary": "Signals",
        "operationId": "signals_api_signals_get",
        "parameters": [
          {
            "name": "strategy",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Strategy"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalsOut"
                }
              }
            }
          },
          "404": {
            "description": "没有这个策略，或还没有行情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/instruments": {
      "get": {
        "tags": [
          "signals"
        ],
        "summary": "Instruments",
        "operationId": "instruments_api_instruments_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InstrumentOut"
                  },
                  "title": "Response Instruments Api Instruments Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/instruments/{code}/bars": {
      "get": {
        "tags": [
          "signals"
        ],
        "summary": "Bars",
        "description": "Defaults: up to the latest session, a year back.",
        "operationId": "bars_api_instruments__code__bars_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "strategy",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Strategy"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityBarsOut"
                }
              }
            }
          },
          "404": {
            "description": "没有这个策略，或还没有行情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BarOut": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "open": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Open"
          },
          "high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "High"
          },
          "low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Low"
          },
          "close": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Close"
          },
          "volume": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Volume"
          }
        },
        "type": "object",
        "required": [
          "date",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "BarOut",
        "description": "Research prices: comparable across splits. None on a halted day."
      },
      "CandidateOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "market": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market"
          },
          "priority": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority"
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reason Codes"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "market",
          "priority",
          "reason_codes"
        ],
        "title": "CandidateOut"
      },
      "DataQuality": {
        "properties": {
          "missing_sessions": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Missing Sessions"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/SecurityGap"
            },
            "type": "array",
            "title": "Gaps"
          },
          "untradable_rows": {
            "type": "integer",
            "title": "Untradable Rows"
          },
          "untradable_on_latest": {
            "type": "integer",
            "title": "Untradable On Latest"
          }
        },
        "type": "object",
        "required": [
          "missing_sessions",
          "gaps",
          "untradable_rows",
          "untradable_on_latest"
        ],
        "title": "DataQuality"
      },
      "DataStatus": {
        "properties": {
          "latest_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Date"
          },
          "securities": {
            "type": "integer",
            "title": "Securities"
          },
          "bar_rows": {
            "type": "integer",
            "title": "Bar Rows"
          },
          "recent_jobs": {
            "items": {
              "$ref": "#/components/schemas/JobResultOut"
            },
            "type": "array",
            "title": "Recent Jobs"
          }
        },
        "type": "object",
        "required": [
          "latest_date",
          "securities",
          "bar_rows",
          "recent_jobs"
        ],
        "title": "DataStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InstrumentOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "name_en": {
            "type": "string",
            "title": "Name En"
          },
          "market": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "name_en",
          "market"
        ],
        "title": "InstrumentOut"
      },
      "JobResultOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "title": "Finished At"
          },
          "summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Summary"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "started_at",
          "finished_at",
          "summary",
          "warnings",
          "error"
        ],
        "title": "JobResultOut"
      },
      "JobStatusOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "progress": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Progress"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "state",
          "submitted_at",
          "started_at",
          "progress"
        ],
        "title": "JobStatusOut"
      },
      "LinePoint": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "date",
          "value"
        ],
        "title": "LinePoint"
      },
      "PlotOut": {
        "properties": {
          "indicator": {
            "type": "string",
            "title": "Indicator"
          },
          "pane": {
            "type": "string",
            "title": "Pane"
          }
        },
        "type": "object",
        "required": [
          "indicator",
          "pane"
        ],
        "title": "PlotOut"
      },
      "Refusal": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Refusal",
        "description": "Why a request was turned away (FastAPI's `HTTPException` shape)."
      },
      "SecurityBarsOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "bars": {
            "items": {
              "$ref": "#/components/schemas/BarOut"
            },
            "type": "array",
            "title": "Bars"
          },
          "plots": {
            "items": {
              "$ref": "#/components/schemas/PlotOut"
            },
            "type": "array",
            "title": "Plots"
          },
          "lines": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/LinePoint"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Lines"
          },
          "entries": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Entries"
          }
        },
        "type": "object",
        "required": [
          "code",
          "bars",
          "plots",
          "lines",
          "entries"
        ],
        "title": "SecurityBarsOut"
      },
      "SecurityGap": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "missing_sessions": {
            "type": "integer",
            "title": "Missing Sessions"
          }
        },
        "type": "object",
        "required": [
          "code",
          "missing_sessions"
        ],
        "title": "SecurityGap"
      },
      "SignalsOut": {
        "properties": {
          "strategy": {
            "type": "string",
            "title": "Strategy"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CandidateOut"
            },
            "type": "array",
            "title": "Candidates"
          }
        },
        "type": "object",
        "required": [
          "strategy",
          "date",
          "candidates"
        ],
        "title": "SignalsOut"
      },
      "SyncAccepted": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          }
        },
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "SyncAccepted"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
